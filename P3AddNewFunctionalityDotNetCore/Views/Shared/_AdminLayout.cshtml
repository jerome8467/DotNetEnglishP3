<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet"
          asp-href-include="/lib/bootstrap/css/bootstrap.min.css"
          asp-href-exclude="**/*-reboot*,**/*-grid*" />
    <link rel="stylesheet" asp-href-include="/css/utility.css" />
    <title>@ViewBag.Title</title>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js">
    </script>
</head>
<body>
    <!--<div class="bg-warning p-2 row">-->
    
    <div class="bg-warning py-2">
        <div class="container-fluid">
            <div class="row align-items-center">

                <div class="container body-content">
                    <div class="container d-flex justify-content-between align-items-center">
                        <div class="col"">
                            <h4>@ViewBag.Title</h4>
                        </div>
                        <a class="btn btn-sm btn-primary"
                           asp-action="Logout" asp-controller="Account">@Localizer["Logout"]</a>
                    </div>

                </div>

            </div>
        </div>
    </div>
    @if (TempData["message"] != null)
    {
        <div class="alert alert-success mt-1">@TempData["message"]</div>
    }
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <div class="row">
                <div class="col-8"><p style="padding-top:17px">&copy; 2022 - P3AddNewFunctionalityDotNetCore</p></div>
                <div class="col-4">
                    @await Component.InvokeAsync("LanguageSelector")
                </div>
            </div>
        </footer>
    </div>
</body>
</html>